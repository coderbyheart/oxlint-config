{
  "name": "@coderbyheart/oxlint-config",
  "version": "0.0.0-development",
  "description": "Oxlint config for my projects.",
  "keywords": [
    "oxlint"
  ],
  "homepage": "https://github.com/coderbyheart/oxlint-config#readme",
  "bugs": {
    "url": "https://github.com/coderbyheart/oxlint-config/issues"
  },
  "license": "MIT",
  "author": "Markus Tacker | https://coderbyheart.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coderbyheart/oxlint-config.git"
  },
  "files": [
    "index.js",
    "LICENSE",
    "README.md",
    "index.d.ts",
    "config.json"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "oxlint *.ts",
    "prepare": "husky && case \"$npm_command\" in install|ci) check-node-version --package ;; esac"
  },
  "dependencies": {
    "@stylistic/eslint-plugin": "6.0.0",
    "eslint-plugin-prefer-arrow": "1.2.3"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "^10.0.1",
    "check-node-version": "4.2.1",
    "commitlint": "21.2.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.78.0"
  },
  "peerDependencies": {
    "oxlint": ">=1.93.0 <2",
    "tsrs": ">=0.25.0-ts7.1.0-beta <2"
  },
  "lint-staged": {
    "*.{yml,md,js,json,ts}": [
      "oxfmt"
    ]
  },
  "release": {
    "branches": [
      "saga"
    ],
    "remoteTags": true,
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      [
        "@semantic-release/github",
        {
          "successCommentCondition": false,
          "failCommentCondition": false
        }
      ]
    ]
  },
  "engines": {
    "node": ">=24.22.1 <25 || >=26.12.1 <27",
    "npm": ">=12.0.2 <13"
  }
}
